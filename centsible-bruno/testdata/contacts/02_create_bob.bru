meta {
  name: 02_create_bob
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/contacts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "firstName": "Bob",
    "lastName": "Nguyen"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.id) {
      bru.setVar("contactBobId", body.id);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
