meta {
  name: 03_create_credit_card
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/api/budget-accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Credit Card",
    "initialBalance": -350.00,
    "currency": "EUR"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.id) {
      bru.setVar("accountCreditCardId", body.id);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
