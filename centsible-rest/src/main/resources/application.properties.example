# ============================================================================
# Application identity
# ============================================================================
spring.application.name=centsible-rest

# ============================================================================
# Persistence
# ============================================================================
# --- Datasource ---
spring.datasource.url=jdbc:postgresql://<url>/budget_planner
spring.datasource.username=<username>
spring.datasource.password=<password>
spring.datasource.driver-class-name=org.postgresql.Driver

# --- Connection pool ---
# Maximum datasource connections; sized explicitly so requests fail fast instead of queueing.
spring.datasource.hikari.maximum-pool-size=${HIKARI_MAX_POOL_SIZE:20}
# Milliseconds to wait for a pool connection before failing.
spring.datasource.hikari.connection-timeout=${HIKARI_CONNECTION_TIMEOUT_MS:10000}

# --- jOOQ ---
spring.jooq.sql-dialect=postgres

# ============================================================================
# Authentication & security
# ============================================================================
# JWT lifetime in milliseconds.
jwt.expiration-ms=86400000
# Base64-encoded JWT signing key, ≥256 bits (`openssl rand -base64 64`).
jwt.secret=<Enter your token>

# Auto-confirms new registrations (dev only; rejected under the prod profile).
skip.email.verification=true

# Long random passphrase that encrypts each user's TOTP secret at rest.
mfa.encryption-key=${MFA_ENCRYPTION_KEY:}
# Hex string, ≥16 chars, for MFA encryption (`openssl rand -hex 16`).
mfa.encryption-salt=${MFA_ENCRYPTION_SALT:}

# Comma-separated origin allowlist for the UI; no wildcards.
cors.allowed-origins=http://localhost:3000

# --- Reverse proxy / client IP ---
# `native` resolves the client IP via trusted proxies, `framework` trusts a client-forgeable header, `none` when nothing fronts the API.
server.forward-headers-strategy=${SERVER_FORWARD_HEADERS_STRATEGY:native}
# Proxy addresses whose `X-Forwarded-*` headers are trusted (CIDR list or regex); override only if your proxy reaches the API from a public address.
# server.tomcat.remoteip.internal-proxies=192.168.0.0/16, 172.16.0.0/12, 10.0.0.0/8, 127.0.0.0/8

# ============================================================================
# Lifecycle
# ============================================================================
# Drain in-flight requests on SIGTERM instead of severing them.
server.shutdown=graceful
# Maximum time to wait for in-flight work to drain before forcing shutdown.
spring.lifecycle.timeout-per-shutdown-phase=20s

# ============================================================================
# Scheduling
# ============================================================================
# Thread-pool size shared by the `@Scheduled` tasks so a slow one can't block the rest.
spring.task.scheduling.pool.size=${SCHEDULING_POOL_SIZE:4}

# ============================================================================
# Response compression
# ============================================================================
# Gzip JSON responses; disable if the reverse proxy already compresses.
server.compression.enabled=${SERVER_COMPRESSION_ENABLED:true}
server.compression.mime-types=application/json
server.compression.min-response-size=1024

# ============================================================================
# Observability
# ============================================================================
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never

# ============================================================================
# Internationalization
# ============================================================================
# Resource-bundle basename for localized validation/error messages and email copy.
spring.messages.basename=messages
spring.messages.encoding=UTF-8

# ============================================================================
# Transaction attachments
# ============================================================================
# Directory where transaction attachments are stored on disk.
attachments.directory=${ATTACHMENTS_DIRECTORY:./data/attachments}
# Maximum size of a single uploaded attachment.
spring.servlet.multipart.max-file-size=11MB
# Maximum total size of a multipart upload request.
spring.servlet.multipart.max-request-size=12MB

# ============================================================================
# Integrations (external provider plugins)
# ============================================================================

# --- Credentials at rest ---
# Passphrase used to derive the AES-256 key that encrypts provider credentials at rest.
integrations.encryption-key=${INTEGRATIONS_ENCRYPTION_KEY:}
# Hex string, ≥16 chars, for integrations encryption (`openssl rand -hex 16`).
integrations.encryption-salt=${INTEGRATIONS_ENCRYPTION_SALT:}

# --- Sync orchestrator ---
# How often the sync orchestrator polls (ms).
integrations.sync.poll-interval-ms=${INTEGRATIONS_SYNC_POLL_INTERVAL_MS:300000}
# How often a single connection is re-synced (s).
integrations.sync.interval-seconds=${INTEGRATIONS_SYNC_INTERVAL_SECONDS:3600}
# Lease TTL after which a stalled sync is reclaimable (s).
integrations.sync.lease-timeout-seconds=${INTEGRATIONS_SYNC_LEASE_TIMEOUT_SECONDS:300}

# --- OAuth redirect URLs ---
# Public URL used to build OAuth redirect URIs; HTTPS in prod.
integrations.base-url=${INTEGRATIONS_BASE_URL:}
# Public UI URL for OAuth return redirects (defaults to the integrations base URL).
integrations.ui-base-url=${INTEGRATIONS_UI_BASE_URL:${INTEGRATIONS_BASE_URL:}}

# --- PayPal provider (per-user credentials come from the UI) ---
# Show the PayPal provider in the UI.
integrations.paypal.enabled=${INTEGRATIONS_PAYPAL_ENABLED:false}
# Default PayPal environment shown to users (`live` or `sandbox`).
integrations.paypal.default-environment=${INTEGRATIONS_PAYPAL_DEFAULT_ENVIRONMENT:live}
# HTTP timeout for PayPal API calls (ms).
integrations.paypal.http-timeout-ms=${INTEGRATIONS_PAYPAL_HTTP_TIMEOUT_MS:15000}

# --- GoCardless Bank Account Data (EU banking under PSD2) ---
# Show the EU banking (GoCardless) provider in the UI.
integrations.banking-gocardless.enabled=${INTEGRATIONS_BANKING_GOCARDLESS_ENABLED:false}
# GoCardless Bank Account Data `secret_id` (operator-level).
integrations.banking-gocardless.secret-id=${INTEGRATIONS_BANKING_GOCARDLESS_SECRET_ID:}
# GoCardless Bank Account Data `secret_key` (operator-level).
integrations.banking-gocardless.secret-key=${INTEGRATIONS_BANKING_GOCARDLESS_SECRET_KEY:}
# GoCardless Bank Account Data API base URL.
integrations.banking-gocardless.api-base=${INTEGRATIONS_BANKING_GOCARDLESS_API_BASE:https://bankaccountdata.gocardless.com/api/v2}
# Minimum gap between syncs to respect GoCardless's rate cap (s).
integrations.banking-gocardless.min-sync-interval-seconds=${INTEGRATIONS_BANKING_GOCARDLESS_MIN_SYNC_INTERVAL_SECONDS:21600}

# --- Currency conversion (foreign-currency transactions) ---
# Enable Frankfurter-backed currency conversion for foreign-currency transactions.
fx.frankfurter.enabled=${FX_FRANKFURTER_ENABLED:true}
# Frankfurter API base URL.
fx.frankfurter.api-base=${FX_FRANKFURTER_API_BASE:https://api.frankfurter.dev}
# Maximum age, in days, of an FX rate before it is considered stale.
fx.stale-tolerance-days=${FX_STALE_TOLERANCE_DAYS:7}
