meta {
  name: update_connection
  type: http
  seq: 4
}

put {
  url: http://localhost:8080/api/integrations/connections/:id
  body: json
  auth: none
}

params:path {
  id: <uuid>
}

body:json {
  {
    "providerKey": "manual",
    "displayName": "Wallet (updated)",
    "values": {
      "label": "Updated label",
      "notes": "Updated notes"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
