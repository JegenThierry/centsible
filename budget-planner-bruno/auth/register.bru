meta {
  name: register
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {    
    "username": "username",
    "password": "password",   
    "email": "email@email.com",
    "firstName": "firstName",
    "lastName": "lastName"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
