meta {
  name: 02_login
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "password": "TestPass123!"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.token) {
      bru.setVar("token", body.token);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
