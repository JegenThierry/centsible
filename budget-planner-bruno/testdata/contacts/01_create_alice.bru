meta {
  name: 01_create_alice
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/contacts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "firstName": "Alice",
    "lastName": "Martin"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.id) {
      bru.setVar("contactAliceId", body.id);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
