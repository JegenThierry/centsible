meta {
  name: 01_fetch_seeded
  type: http
  seq: 1
}

get {
  url: http://localhost:8080/api/categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const list = res.getBody() || [];
    const byName = (n) => list.find((c) => c.name === n);
    const map = {
      "Food": "categoryFoodId",
      "Transport": "categoryTransportId",
      "Housing": "categoryHousingId",
      "Entertainment": "categoryEntertainmentId",
      "Salary": "categorySalaryId"
    };
    for (const [name, varName] of Object.entries(map)) {
      const cat = byName(name);
      if (cat && cat.id != null) {
        bru.setVar(varName, cat.id);
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
