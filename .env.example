# ============================================================================
# Database
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_super_strong_password
POSTGRES_DB=centsible
DB_HOST_PORT=5432

# ============================================================================
# REST API
# ============================================================================
REST_HOST_PORT=8080
# Activate production guards
SPRING_PROFILES_ACTIVE=prod
# Must be https:// in prod (appears in confirmation emails).
APP_BASE_URL=https://centsible.example.com
JAVA_OPTS='-Xms128m -Xmx384m'

# --- Authentication ---
JWT_SECRET=your-secret-here
JWT_EXPIRATION_MS=14400000
# Required in prod (cookie won't transmit over HTTP otherwise).
AUTH_COOKIE_SECURE=true
# Set when UI + API share a parent domain.
AUTH_COOKIE_DOMAIN=
# Flip to true to allow new account signup, then back to false once you have your account.
REGISTRATION_ENABLED=false
SKIP_EMAIL_VERIFICATION=false

# --- CORS & reverse proxy ---
# Comma-separated; wildcards are not allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# `framework` honours X-Forwarded-* from a trusted reverse proxy. Use `none` if no proxy.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# --- Transaction attachments ---
ATTACHMENTS_DIRECTORY=/var/centsible/attachments
MULTIPART_MAX_FILE_SIZE=11MB
MULTIPART_MAX_REQUEST_SIZE=12MB

# ============================================================================
# Email (Resend)
# ============================================================================
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=centsible@resend.dev

# ============================================================================
# Export service (internal worker, not published)
# ============================================================================
# Adjust polling cadence and lease TTL as needed.
EXPORT_POLL_INTERVAL_MS=2000
EXPORT_LEASE_TIMEOUT_SECONDS=300
EXPORT_JAVA_OPTS='-Xms256m -Xmx512m'

# ============================================================================
# Integrations (external provider plugins)
# ============================================================================

# --- Credentials at rest ---
# Strong passphrase used to derive the AES-256 key that encrypts provider credentials at rest.
# Required only when storing credentials for an integration (e.g. PayPal/banking API keys).
INTEGRATIONS_ENCRYPTION_KEY=change_me_long_random_passphrase
# Hex string, at least 16 characters. Generate with: openssl rand -hex 16
INTEGRATIONS_ENCRYPTION_SALT=deadbeefcafebabe1234567890abcdef

# --- Sync orchestrator ---
# How often the sync orchestrator polls (ms) and how often a single connection is re-synced (s).
INTEGRATIONS_SYNC_POLL_INTERVAL_MS=300000
INTEGRATIONS_SYNC_INTERVAL_SECONDS=3600

# --- OAuth redirect URLs ---
# Public-facing base URL used to build OAuth2 redirect URIs (e.g. for GoCardless).
# Must be HTTPS in production; banks refuse insecure redirect URIs. localhost/127.0.0.1 may
# use http for development. The redirect URI handed to providers is constructed as
#   ${INTEGRATIONS_BASE_URL}/api/integrations/oauth/callback/{providerKey}
# so register that URI in your provider's developer dashboard.
INTEGRATIONS_BASE_URL=https://centsible.example.com
# Where to send the user's browser AFTER the OAuth callback finishes. Defaults to
# INTEGRATIONS_BASE_URL — set this in split deployments where the Nuxt UI runs on a
# different host than the REST API (e.g. app.example.com vs api.example.com).
INTEGRATIONS_UI_BASE_URL=https://centsible.example.com

# --- Provider toggles ---
# Per-provider toggles. Each provider built into the image exposes one of these
# (convention: INTEGRATIONS_<PROVIDER>_ENABLED). Set to `false` to disable a
# provider without rebuilding. Providers not compiled into the image (see
# centsible-rest/build.gradle.kts) cannot be enabled this way.

# Manual provider
INTEGRATIONS_MANUAL_ENABLED=true

# PayPal — disabled by default. Per-user credentials are entered in the UI, not here:
# each user creates a REST API app at https://developer.paypal.com to obtain a
# clientId/clientSecret.
# Default environment for new PayPal connections (sandbox | live); user can override per-connection.
INTEGRATIONS_PAYPAL_DEFAULT_ENVIRONMENT=live
INTEGRATIONS_PAYPAL_HTTP_TIMEOUT_MS=15000

# GoCardless Bank Account Data (formerly Nordigen) — EU banking under PSD2.
# Operator-level credentials shared across all users on this instance. Register at
# https://bankaccountdata.gocardless.com and obtain a secret_id + secret_key.
# End users only authorize bank consent through the OAuth flow; they never see these secrets.
INTEGRATIONS_BANKING_GOCARDLESS_ENABLED=false
INTEGRATIONS_BANKING_GOCARDLESS_SECRET_ID=
INTEGRATIONS_BANKING_GOCARDLESS_SECRET_KEY=
# Respects GoCardless's 4-req/account/day rate cap; do not lower below 6h in production.
INTEGRATIONS_BANKING_GOCARDLESS_MIN_SYNC_INTERVAL_SECONDS=21600

# ============================================================================
# UI
# ============================================================================
UI_HOST_PORT=3000
NUXT_PUBLIC_API_BASE=http://localhost:8080/api
NUXT_API_BASE_SSR=http://centsible-rest:8080/api

# ============================================================================
# Runtime
# ============================================================================
TZ=UTC

# ============================================================================
# Build tooling (host-side, not consumed by Docker services)
# ============================================================================
NVD_API_KEY=

# ============================================================================
# Reverse-proxy deployment (docker-compose.prod.yml only)
# ============================================================================
PROXY_NETWORK=nginx-proxy-manager_default
