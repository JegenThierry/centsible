# ============================================================================
# Centsible deployment configuration
# ============================================================================

# ============================================================================
# Database
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_super_strong_password
POSTGRES_DB=centsible

# ============================================================================
# REST API
# ============================================================================
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=https://centsible.example.com
JAVA_OPTS='-Xms128m -Xmx384m'

# --- Authentication ---
JWT_SECRET=your-secret-here
JWT_EXPIRATION_MS=14400000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
REGISTRATION_ENABLED=false
SKIP_EMAIL_VERIFICATION=false

# --- Admin area (user management) ---
# ADMIN_USERNAME grants that account access to the admin view (list/delete users,
# resend verification emails). ADMIN_ENABLED=false switches the feature off entirely.
# When ADMIN_ENABLED=true, ADMIN_USERNAME must be set (boot fails otherwise under prod).
ADMIN_ENABLED=false
ADMIN_USERNAME=

# --- Two-factor (TOTP) secret encryption at rest ---
# Encrypts each user's TOTP secret (AES-GCM). Generate fresh values; never reuse the placeholders.
# Key: any long random passphrase. Salt: hex string, >= 16 chars.
MFA_ENCRYPTION_KEY=change_me_long_random_passphrase
MFA_ENCRYPTION_SALT=deadbeefcafebabe1234567890abcdef

# --- CORS & reverse proxy ---
CORS_ALLOWED_ORIGINS=https://centsible.example.com
# `native` resolves the client IP by walking X-Forwarded-For back through the trusted proxy ranges.
# `framework` trusts the leftmost XFF entry, which the client itself can forge — and that address is
# what the auth rate limiter buckets on. Use `none` only when nothing fronts the API.
SERVER_FORWARD_HEADERS_STRATEGY=native

# --- Transaction attachments ---
ATTACHMENTS_DIRECTORY=/var/centsible/attachments
MULTIPART_MAX_FILE_SIZE=11MB
MULTIPART_MAX_REQUEST_SIZE=12MB

# ============================================================================
# Email (Resend)
# ============================================================================
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=centsible@resend.dev

# ============================================================================
# Export service (internal worker, not published)
# ============================================================================
EXPORT_POLL_INTERVAL_MS=2000
EXPORT_LEASE_TIMEOUT_SECONDS=300
EXPORT_RENDER_TIMEOUT_MS=60000
EXPORT_JAVA_OPTS='-Xms256m -Xmx512m'

# ============================================================================
# Integrations (external provider plugins)
# ============================================================================

# --- Credentials at rest ---
INTEGRATIONS_ENCRYPTION_KEY=change_me_long_random_passphrase
INTEGRATIONS_ENCRYPTION_SALT=deadbeefcafebabe1234567890abcdef

# --- Sync orchestrator ---
INTEGRATIONS_SYNC_POLL_INTERVAL_MS=300000
INTEGRATIONS_SYNC_INTERVAL_SECONDS=3600

# --- OAuth redirect URLs ---
INTEGRATIONS_BASE_URL=https://centsible.example.com
INTEGRATIONS_UI_BASE_URL=https://centsible.example.com

# --- Provider toggles ---
INTEGRATIONS_MANUAL_ENABLED=true
INTEGRATIONS_PAYPAL_DEFAULT_ENVIRONMENT=live
INTEGRATIONS_PAYPAL_HTTP_TIMEOUT_MS=15000
INTEGRATIONS_BANKING_GOCARDLESS_ENABLED=false
INTEGRATIONS_BANKING_GOCARDLESS_SECRET_ID=
INTEGRATIONS_BANKING_GOCARDLESS_SECRET_KEY=
INTEGRATIONS_BANKING_GOCARDLESS_MIN_SYNC_INTERVAL_SECONDS=21600

# ============================================================================
# UI
# ============================================================================
NUXT_PUBLIC_API_BASE=https://centsible.example.com/api
NUXT_API_BASE_SSR=http://centsible-rest:8080/api

# ============================================================================
# Runtime
# ============================================================================
TZ=UTC

# ============================================================================
# Images
# ============================================================================
CENTSIBLE_VERSION=local

# ============================================================================
# Reverse-proxy deployment
# ============================================================================
PROXY_NETWORK=nginx-proxy-manager_default

# ============================================================================
# Build tooling (host-side, not consumed by Docker services)
# ============================================================================
NVD_API_KEY=
