# ============================================================================
# Centsible deployment configuration
# ============================================================================

# External Docker network of the reverse proxy.
PROXY_NETWORK=traefik-network

# Domain of the application. Note this is different to the app base URL.
DOMAIN=centsible.example.com

# Timezone applied to all containers.
TZ=UTC

# ============================================================================
# Database
# ============================================================================

# Database username.
POSTGRES_USER=postgres

# Database password
POSTGRES_PASSWORD=change_me_super_strong_password

# Database name.
POSTGRES_DB=centsible

# ============================================================================
# REST API
# ============================================================================

# Leave on `prod` for public facing deployments.
SPRING_PROFILES_ACTIVE=prod
# User-facing UI origin used in email links; must be https://... in prod.
APP_BASE_URL=https://centsible.example.com
# JVM options for the REST container.
JAVA_OPTS='-Xms128m -Xmx384m'

# --- Authentication ---
# Base64-encoded JWT signing key, >=256 bits (openssl rand -base64 64).
JWT_SECRET=your-secret-here
# JWT lifetime in milliseconds.
JWT_EXPIRATION_MS=14400000
# Sets the `Secure` flag on the auth cookie; must be true in prod.
AUTH_COOKIE_SECURE=true
# Cookie `Domain` attribute; set when UI and API share a parent domain.
AUTH_COOKIE_DOMAIN=
# Kill switch for POST /api/auth/register.
REGISTRATION_ENABLED=false
# Auto-confirms new registrations (dev only; rejected under the prod profile).
SKIP_EMAIL_VERIFICATION=false

# --- Admin area (user management) ---
# Kill switch for the admin area; when true, ADMIN_USERNAME must be set.
ADMIN_ENABLED=false
# Account granted the admin view (list/delete users, resend verification emails).
ADMIN_USERNAME=

# --- Two-factor (TOTP) secret encryption at rest ---
# Long random passphrase that encrypts each user's TOTP secret at rest.
MFA_ENCRYPTION_KEY=change_me_long_random_passphrase
# Hex string, >=16 chars, for MFA encryption (openssl rand -hex 16).
MFA_ENCRYPTION_SALT=deadbeefcafebabe1234567890abcdef

# --- CORS & reverse proxy ---
# Comma-separated origin allowlist for the UI; no wildcards.
CORS_ALLOWED_ORIGINS=https://centsible.example.com
# `native` resolves the client IP via trusted proxies, `framework` trusts a client-forgeable header, `none` when nothing fronts the API.
SERVER_FORWARD_HEADERS_STRATEGY=native

# --- Transaction attachments ---
# Directory where transaction attachments are stored on disk.
ATTACHMENTS_DIRECTORY=/var/centsible/attachments
# Maximum size of a single uploaded attachment.
MULTIPART_MAX_FILE_SIZE=11MB
# Maximum total size of a multipart upload request.
MULTIPART_MAX_REQUEST_SIZE=12MB

# ============================================================================
# Email (Resend)
# ============================================================================
# API key for the Resend email service.
RESEND_API_KEY=re_123456789
# "From" address on outbound mail.
RESEND_FROM_EMAIL=centsible@resend.dev

# ============================================================================
# Export service (internal worker, not published)
# ============================================================================
# How often the export worker polls for queued jobs (ms).
EXPORT_POLL_INTERVAL_MS=2000
# Lease TTL after which an unfinished job is reclaimable by another worker (s).
EXPORT_LEASE_TIMEOUT_SECONDS=300
# Playwright timeout for a single PDF render (ms).
EXPORT_RENDER_TIMEOUT_MS=60000
# JVM options for the export container.
EXPORT_JAVA_OPTS='-Xms256m -Xmx512m'

# ============================================================================
# UI
# ============================================================================
# Public API URL used by the browser.
NUXT_PUBLIC_API_BASE=https://centsible.example.com/api
# API URL used during Nuxt SSR.
NUXT_API_BASE_SSR=http://centsible-rest:8080/api

# ============================================================================
# Images
# ============================================================================
# Container image tag to deploy.
CENTSIBLE_VERSION=local

# ============================================================================
# Build tooling (host-side, not consumed by Docker services)
# ============================================================================
# API key for OWASP dependency-check NVD lookups (host-side tooling only).
NVD_API_KEY=
