# ===== Database =====
POSTGRES_USER=postgres
# openssl rand -base64 32
POSTGRES_PASSWORD=change_me_super_strong_password
POSTGRES_DB=budget_planner
# Bound to 127.0.0.1 in docker-compose.yml — host-local access only.
DB_HOST_PORT=5432

# ===== REST API =====
REST_HOST_PORT=8080
# openssl rand -base64 64 (≥256 bits)
JWT_SECRET=your-secret-here
JWT_EXPIRATION_MS=14400000
# MUST be https:// in prod (appears in confirmation emails).
APP_BASE_URL=https://budget.example.com
SKIP_EMAIL_VERIFICATION=false
# Activates ProductionGuard checks.
SPRING_PROFILES_ACTIVE=prod
# Comma-separated; never wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Flip to true to allow new account signup, then back to false once you have your account.
REGISTRATION_ENABLED=false
# Required in prod (cookie won't transmit over HTTP otherwise).
AUTH_COOKIE_SECURE=true
# Set when UI + API share a parent domain.
AUTH_COOKIE_DOMAIN=
# `framework` honours X-Forwarded-* from a trusted reverse proxy. Use `none` if no proxy.
SERVER_FORWARD_HEADERS_STRATEGY=framework

JAVA_OPTS='-Xms128m -Xmx384m'

# ===== Resend (email) =====
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=centsible@resend.dev

# ===== Export Service =====
# Internal worker — not published. Adjust polling cadence and lease TTL as needed.
EXPORT_POLL_INTERVAL_MS=2000
EXPORT_LEASE_TIMEOUT_SECONDS=300
EXPORT_JAVA_OPTS='-Xms256m -Xmx512m'

# ===== Integrations (external provider plugins) =====
# Strong passphrase used to derive the AES-256 key that encrypts provider credentials at rest.
# Required only when storing credentials for an integration (e.g. PayPal/banking API keys).
INTEGRATIONS_ENCRYPTION_KEY=change_me_long_random_passphrase
# Hex string, at least 16 characters. Generate with: openssl rand -hex 16
INTEGRATIONS_ENCRYPTION_SALT=deadbeefcafebabe1234567890abcdef
# How often the sync orchestrator polls (ms) and how often a single connection is re-synced (s).
INTEGRATIONS_SYNC_POLL_INTERVAL_MS=300000
INTEGRATIONS_SYNC_INTERVAL_SECONDS=3600

# ===== UI =====
UI_HOST_PORT=3000
NUXT_PUBLIC_API_BASE=http://localhost:8080/api
NUXT_API_BASE_SSR=http://budget-planner-rest:8080/api

# ===== Runtime =====
TZ=UTC
